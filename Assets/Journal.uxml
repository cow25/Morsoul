<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Journal.uss"/>
    <ui:VisualElement name="Journal-Root" class="journal-root" style="position: absolute; width: 100%; height: 100%; display: none;">
        <ui:VisualElement name="JournalDeskContainer" class="journal-desk-container">
            <ui:VisualElement name="BookmarkStrip" class="journal-bookmark-strip">
                <ui:Button name="TabPhysical" text="Physical" class="journal-tab journal-tab--active"/>
                <ui:Button name="TabTestimony" text="Testimony" class="journal-tab"/>
                <ui:Button name="TabLogs" text="Runic Logs" class="journal-tab"/>
                <ui:Button name="TabDossier" text="Dossier" class="journal-tab"/>
            </ui:VisualElement>
            <ui:VisualElement name="JournalPanel" class="journal-panel">
                <ui:VisualElement name="BookPagesRow" class="journal-pages-row">
                    <ui:VisualElement name="LeftPage" class="journal-page journal-page-left">
                        <ui:ScrollView name="TabBody" class="journal-tab-body"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="RightPage" class="journal-page journal-page-right">
                        <ui:VisualElement name="HeaderRow" class="journal-header-row">
                            <ui:Label name="JournalTitle" text="Investigation Diary" class="journal-title"/>
                            <ui:Label name="JournalType" text="Case Record" class="journal-type"/>
                        </ui:VisualElement>
                        <ui:ScrollView name="JournalDescScroll" class="journal-desc-scroll">
                            <ui:Label name="JournalDesc" text="Inspect collected physical evidence, witness testimonies, decoded runic logs, and NPC dossiers." class="journal-desc" style="white-space: normal;"/>
                        </ui:ScrollView>
                        <ui:Label name="JournalFooterHint" text="[1-4] or [Q/E] Tabs  |  [W/S] Select  |  [G] or [ESC] Close" class="journal-footer-hint" style="white-space: normal;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
