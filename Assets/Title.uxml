<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Title.uss"/>
    <ui:VisualElement name="Title-Root" class="title-root">
        <!-- Top-Left Title Logo -->
        <ui:VisualElement class="title-header" picking-mode="Ignore">
            <ui:Label text="MORSOUL" class="title-logo" picking-mode="Ignore"/>
            <ui:Label text="World's Case" class="title-subtitle" picking-mode="Ignore"/>
        </ui:VisualElement>

        <!-- Left-Aligned Primary Menu -->
        <ui:VisualElement name="MenuStack" class="title-menu-stack">
            <ui:VisualElement name="StartGameRow" class="title-menu-row title-menu-row--active">
                <ui:VisualElement class="title-menu-btn-line">
                    <ui:Button name="StartGameButton" text="Continue" class="title-menu-btn"/>
                    <ui:VisualElement class="title-menu-diamond" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement class="title-menu-underline" picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:VisualElement name="LoadGameRow" class="title-menu-row">
                <ui:VisualElement class="title-menu-btn-line">
                    <ui:Button name="LoadGameButton" text="Load Game" class="title-menu-btn"/>
                    <ui:VisualElement class="title-menu-diamond" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement class="title-menu-underline" picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:VisualElement name="NewGameRow" class="title-menu-row">
                <ui:VisualElement class="title-menu-btn-line">
                    <ui:Button name="NewGameButton" text="New Game" class="title-menu-btn"/>
                    <ui:VisualElement class="title-menu-diamond" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement class="title-menu-underline" picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:VisualElement name="SettingsRow" class="title-menu-row">
                <ui:VisualElement class="title-menu-btn-line">
                    <ui:Button name="SettingsButton" text="Settings" class="title-menu-btn"/>
                    <ui:VisualElement class="title-menu-diamond" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement class="title-menu-underline" picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:VisualElement name="ExitRow" class="title-menu-row">
                <ui:VisualElement class="title-menu-btn-line">
                    <ui:Button name="ExitButton" text="Exit" class="title-menu-btn"/>
                    <ui:VisualElement class="title-menu-diamond" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement class="title-menu-underline" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom-Left Credit -->
        <ui:Label text="An original Game made by Group 2" class="title-credit" picking-mode="Ignore"/>

        <!-- Save Slot Tarot Modal -->
        <ui:VisualElement name="SaveSlotModal" class="title-modal-backdrop" style="display: none;">
            <ui:Label name="SaveSlotHeader" text="Load Existing Game Save" class="title-modal-header" picking-mode="Ignore"/>
            <ui:VisualElement class="save-card-frame">
                <ui:VisualElement class="save-slots-row">
                    <ui:Button name="Slot1Card" class="tarot-card">
                        <ui:Label name="Slot1Title" text="Save 1" class="tarot-title" picking-mode="Ignore"/>
                        <ui:VisualElement name="Slot1Portrait" class="tarot-portrait" picking-mode="Ignore"/>
                        <ui:Label name="Slot1Subtitle" text="" class="tarot-subtitle" picking-mode="Ignore"/>
                    </ui:Button>
                    <ui:Button name="Slot2Card" class="tarot-card">
                        <ui:Label name="Slot2Title" text="Empty Slot" class="tarot-title" picking-mode="Ignore"/>
                        <ui:VisualElement name="Slot2Portrait" class="tarot-portrait" style="display: none;" picking-mode="Ignore"/>
                        <ui:Label name="Slot2Subtitle" text="Slot 2" class="tarot-subtitle" style="opacity: 0.45;" picking-mode="Ignore"/>
                    </ui:Button>
                    <ui:Button name="Slot3Card" class="tarot-card">
                        <ui:Label name="Slot3Title" text="Empty Slot" class="tarot-title" picking-mode="Ignore"/>
                        <ui:VisualElement name="Slot3Portrait" class="tarot-portrait" style="display: none;" picking-mode="Ignore"/>
                        <ui:Label name="Slot3Subtitle" text="Slot 3" class="tarot-subtitle" style="opacity: 0.45;" picking-mode="Ignore"/>
                    </ui:Button>
                </ui:VisualElement>

                <!-- Overwrite Confirmation -->
                <ui:VisualElement name="OverwritePrompt" class="overwrite-backdrop" style="display: none;">
                    <ui:VisualElement class="overwrite-card">
                        <ui:Label text="Overwrite Save?" class="overwrite-title" picking-mode="Ignore"/>
                        <ui:Button name="OverwriteYes" text="Yes" class="title-parchment-btn"/>
                        <ui:Button name="OverwriteNo" text="No" class="title-parchment-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="SaveStatusLabel" text="" class="save-status-label" picking-mode="Ignore"/>
            <ui:Button name="SaveModalBackButton" text="Back  [ESC]" class="title-parchment-btn"/>
        </ui:VisualElement>

        <!-- Settings Modal -->
        <ui:VisualElement name="SettingsModal" class="title-modal-backdrop" style="display: none;">
            <ui:VisualElement class="settings-card">
                <ui:Label text="Morsoul : Settings" class="settings-card-title" picking-mode="Ignore"/>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="Master Volume" class="settings-label"/>
                    <ui:VisualElement class="settings-bar-wrap">
                        <ui:Button name="MasterMinusButton" text="-" class="settings-step-btn"/>
                        <ui:VisualElement class="settings-track">
                            <ui:VisualElement name="MasterFill" class="settings-fill"/>
                        </ui:VisualElement>
                        <ui:Button name="MasterPlusButton" text="+" class="settings-step-btn"/>
                        <ui:Label name="MasterValueLabel" text="100%" class="settings-val"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="Music Volume" class="settings-label"/>
                    <ui:VisualElement class="settings-bar-wrap">
                        <ui:Button name="MusicMinusButton" text="-" class="settings-step-btn"/>
                        <ui:VisualElement class="settings-track">
                            <ui:VisualElement name="MusicFill" class="settings-fill"/>
                        </ui:VisualElement>
                        <ui:Button name="MusicPlusButton" text="+" class="settings-step-btn"/>
                        <ui:Label name="MusicValueLabel" text="100%" class="settings-val"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-row">
                    <ui:Label text="SFX Volume" class="settings-label"/>
                    <ui:VisualElement class="settings-bar-wrap">
                        <ui:Button name="SfxMinusButton" text="-" class="settings-step-btn"/>
                        <ui:VisualElement class="settings-track">
                            <ui:VisualElement name="SfxFill" class="settings-fill"/>
                        </ui:VisualElement>
                        <ui:Button name="SfxPlusButton" text="+" class="settings-step-btn"/>
                        <ui:Label name="SfxValueLabel" text="100%" class="settings-val"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="settings-footer">
                    <ui:Button name="FullscreenButton" text="Fullscreen: ON" class="title-parchment-btn" style="margin-top: 0;"/>
                    <ui:Button name="SettingsBackButton" text="Back  [ESC]" class="title-parchment-btn" style="margin-top: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

