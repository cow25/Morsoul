.journal-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    background-color: rgba(10, 9, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.journal-desk-container {
    width: 78%;
    max-width: 1120px;
    height: 76%;
    max-height: 700px;
    flex-direction: column;
    align-items: stretch;
}

.journal-bookmark-strip {
    flex-direction: row;
    padding-left: 48px;
    margin-bottom: -6px;
    flex-shrink: 0;
}

.journal-tab {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_FrameSlot03a.png");
    -unity-background-image-tint-color: rgb(92, 74, 54);
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 18px 10px 18px;
    margin-right: 6px;
    color: rgb(224, 210, 184);
    font-size: 13px;
}

.journal-tab:hover {
    -unity-background-image-tint-color: rgb(128, 102, 70);
    color: rgb(255, 240, 206);
}

.journal-tab--active {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 214, 174);
    color: rgb(32, 22, 14);
    -unity-font-style: bold;
}

.journal-panel {
    flex-grow: 1;
    background-image: url("project://database/Assets/Art/UI/Open_Book_Parchment.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 44px 56px 46px 56px;
    flex-direction: column;
}

.journal-pages-row {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
}

.journal-page {
    width: 46.5%;
    flex-direction: column;
}

.journal-page-left {
    padding-right: 12px;
}

.journal-page-right {
    padding-left: 16px;
    justify-content: flex-start;
}

.journal-header-row {
    flex-direction: column;
    border-bottom-width: 1px;
    border-bottom-color: rgba(88, 66, 44, 0.45);
    padding-bottom: 10px;
    margin-bottom: 14px;
    flex-shrink: 0;
}

.journal-title {
    font-size: 23px;
    color: rgb(38, 26, 18);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.journal-type {
    font-size: 13px;
    color: rgb(118, 78, 32);
    -unity-font-style: italic;
}

.journal-desc {
    font-size: 15px;
    color: rgb(52, 38, 26);
}

.journal-footer-hint {
    margin-top: auto;
    font-size: 12px;
    color: rgba(74, 56, 40, 0.8);
    -unity-text-align: middle-right;
    padding-top: 12px;
}

.journal-tab-body {
    flex-grow: 1;
    padding-right: 6px;
}

.journal-card {
    background-color: rgba(244, 232, 206, 0.72);
    border-color: rgba(112, 84, 52, 0.55);
    border-width: 1px;
    border-radius: 5px;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.journal-card-name {
    font-size: 15px;
    color: rgb(34, 22, 14);
    -unity-font-style: bold;
}

.journal-card-meta {
    font-size: 12px;
    color: rgb(114, 74, 30);
    margin-top: 2px;
}

.journal-card-preview {
    font-size: 13px;
    color: rgb(56, 42, 30);
    white-space: normal;
    margin-top: 5px;
}

.log--locked {
    background-color: rgba(182, 166, 142, 0.55);
    border-color: rgba(112, 92, 68, 0.5);
}

.log--locked .journal-card-name {
    color: rgb(78, 66, 54);
}

.log--locked .journal-card-meta {
    color: rgb(104, 88, 70);
}

.dissonance-banner {
    background-color: rgba(108, 62, 134, 0.16);
    border-color: rgb(118, 56, 142);
    border-width: 1px;
    border-radius: 6px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

.dissonance-title {
    font-size: 16px;
    color: rgb(88, 34, 114);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.dissonance-line {
    font-size: 13px;
    color: rgb(48, 28, 58);
    white-space: normal;
}

.dissonance-location {
    font-size: 12px;
    color: rgb(108, 46, 132);
    margin-top: 6px;
}

.empty-label {
    font-size: 14px;
    color: rgba(88, 68, 48, 0.85);
    padding: 20px 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}
