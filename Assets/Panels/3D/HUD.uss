.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
}

.hud-panel {
    background-color: transparent;
}

.hud-text {
    font-size: 16px;
    color: rgb(246, 242, 232);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.9);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.92);
}

.hud-text-large {
    font-size: 17px;
    color: rgb(248, 244, 234);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.9);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.95);
    -unity-font-style: bold;
}

.hud-text-small {
    font-size: 12px;
    color: rgb(216, 210, 198);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 8, 12, 0.85);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* Top-Left Portrait + Focus */
.hud-top-left {
    position: absolute;
    top: 16px;
    left: 18px;
    flex-direction: row;
    align-items: flex-start;
}

.hud-user-col {
    align-items: center;
    margin-right: 12px;
}

.hud-portrait-frame {
    width: 52px;
    height: 52px;
    padding: 3px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_FrameSlot03a.png");
    -unity-background-image-tint-color: rgb(225, 200, 145);
    -unity-background-scale-mode: stretch-to-fill;
    margin-bottom: 4px;
}

.hud-portrait-img {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Art/UI/Golem_Portrait.png");
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 2px;
}

.hud-user-name {
    font-size: 13px;
    color: rgb(246, 242, 232);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(10, 8, 12, 0.9);
    text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.hud-focus-col {
    justify-content: flex-start;
    padding-top: 4px;
}

.hud-focus-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.hud-focus-track {
    width: 204px;
    height: 17px;
    padding: 2px;
    background-color: rgba(236, 232, 224, 0.90);
    border-color: rgba(34, 28, 38, 0.88);
    border-width: 1.5px;
    border-radius: 3px;
}

.hud-focus-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(130, 80, 160);
    border-radius: 2px;
}

/* Keycaps */
.keycap {
    min-width: 28px;
    height: 22px;
    padding: 1px 7px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Frame01a.png");
    -unity-background-image-tint-color: rgba(46, 46, 56, 0.9);
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    color: rgb(242, 238, 228);
    font-size: 12px;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.85);
}

.keycap-button {
    min-width: 30px;
    height: 22px;
    padding: 1px 8px;
    margin: 0;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Frame01a.png");
    -unity-background-image-tint-color: rgba(58, 56, 68, 0.9);
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    color: rgb(242, 238, 228);
    font-size: 12px;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}

.keycap-button:hover {
    -unity-background-image-tint-color: rgba(112, 92, 138, 0.95);
    color: white;
}

.keycap-esc {
    min-width: 34px;
    height: 20px;
    font-size: 11px;
    padding: 1px 6px;
}

/* Top-Center Active Goal & Top-Right Case */
.hud-top-center {
    position: absolute;
    top: 12px;
    left: 24%;
    right: 24%;
    align-items: center;
}

.hud-goal-title {
    font-size: 18px;
    color: rgb(248, 244, 232);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.92);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.95);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-goal-desc {
    font-size: 14px;
    color: rgb(236, 232, 222);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.9);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 2px;
}

.hud-top-right {
    position: absolute;
    top: 16px;
    right: 22px;
    align-items: flex-end;
}

.hud-case-label {
    font-size: 16px;
    color: rgb(248, 242, 226);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.9);
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-right;
}

/* Bottom-Left Abilities */
.hud-bottom-left {
    position: absolute;
    bottom: 18px;
    left: 20px;
    flex-direction: column;
}

.hud-ability-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.hud-ability-key {
    min-width: 32px;
    margin-right: 10px;
}

.hud-ability-frame {
    width: 34px;
    height: 34px;
    padding: 2px;
    margin-right: 10px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_FrameSlot03a.png");
    -unity-background-image-tint-color: rgb(210, 195, 165);
    -unity-background-scale-mode: stretch-to-fill;
}

.icon-box {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.icon-golem-eye {
    background-image: url("project://database/Assets/Art/UI/Ability_GolemEye.png");
}

.icon-aether-sight {
    background-image: url("project://database/Assets/Art/UI/Ability_AetherSight.png");
}

.icon-emotion-echo {
    background-image: url("project://database/Assets/Art/UI/Ability_EmotionEcho.png");
}

/* Bottom-Right Controls */
.hud-bottom-right {
    position: absolute;
    bottom: 18px;
    right: 22px;
    align-items: flex-end;
}

.hud-shortcut-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.hud-shortcut-label {
    font-size: 15px;
    color: rgb(246, 242, 232);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(12, 10, 14, 0.9);
    text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.95);
    margin-right: 10px;
}
