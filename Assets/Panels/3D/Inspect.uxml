<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="InspectRoot" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(8, 10, 14, 0.72); display: none; align-items: center; justify-content: center;">
        <ui:Image name="InspectImage" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:VisualElement style="position: absolute; bottom: 6%; width: 64%; max-width: 860px; align-items: center; background-color: rgba(14, 16, 22, 0.86); border-color: rgba(114, 206, 224, 0.55); border-width: 1.5px; border-radius: 6px; padding: 14px 20px;">
            <ui:Label name="InspectDescription" text="Clue description goes here." style="font-size: 16px; color: rgb(232, 228, 218); white-space: normal; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/EBGaramond.ttf&quot;);"/>
            <ui:Button text="[E / ESC] Close" name="CloseInspectButton" style="font-size: 13px; color: rgb(224, 232, 240); background-color: rgba(62, 168, 192, 0.25); border-color: rgba(114, 206, 224, 0.7); border-width: 1px; border-radius: 4px; padding: 4px 14px; margin-top: 12px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/EBGaramond.ttf&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
