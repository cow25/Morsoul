<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/HUD.uss?fileID=7433441132597879392&amp;guid=05eccd6dbf30c0f40a158796a198cda4&amp;type=3#HUD"/>
    <ui:VisualElement name="HUD-Root" class="hud-root" picking-mode="Ignore">
        <!-- Top-Left: Portrait + Name + ESC + Focus Energy -->
        <ui:VisualElement name="TopLeftPanel" class="hud-panel hud-top-left" picking-mode="Ignore">
            <ui:VisualElement class="hud-user-col" picking-mode="Ignore">
                <ui:VisualElement class="hud-portrait-frame" picking-mode="Ignore">
                    <ui:VisualElement name="UserIcon" class="hud-portrait-img" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:Label text="User" name="UserNameLabel" class="hud-user-name" picking-mode="Ignore"/>
                <ui:Button text="ESC" name="EscKeyButton" class="keycap-button keycap-esc"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-focus-col" picking-mode="Ignore">
                <ui:VisualElement class="hud-focus-header" picking-mode="Ignore">
                    <ui:Label text="Focus Energy:" class="hud-text" style="margin-right: 6px;" picking-mode="Ignore"/>
                    <ui:Label text="120/120" name="FocusValueLabel" class="hud-text" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="FocusBarBackground" class="hud-focus-track" picking-mode="Ignore">
                    <ui:VisualElement name="FocusBarFill" class="hud-focus-fill" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Top-Center: Active Goal -->
        <ui:VisualElement name="ObjectivePanel" class="hud-top-center" picking-mode="Ignore">
            <ui:Label name="ActiveGoalTitle" text="Active Goal" class="hud-goal-title" picking-mode="Ignore"/>
            <ui:Label name="ObjectiveLabel" text="Examine the ancient runes and locate clues." class="hud-goal-desc" picking-mode="Ignore"/>
        </ui:VisualElement>

        <!-- Top-Right: Case -->
        <ui:VisualElement name="TopRightPanel" class="hud-top-right" picking-mode="Ignore">
            <ui:Label name="CaseLabel" text="Prologue" class="hud-case-label" picking-mode="Ignore"/>
        </ui:VisualElement>

        <!-- Bottom-Left: Abilities -->
        <ui:VisualElement name="BottomLeftPanel" class="hud-panel hud-bottom-left" picking-mode="Ignore">
            <ui:VisualElement name="GolemEyeRow" class="hud-ability-row" picking-mode="Ignore">
                <ui:Label text="Tab" class="keycap hud-ability-key" picking-mode="Ignore"/>
                <ui:VisualElement class="hud-ability-frame" picking-mode="Ignore">
                    <ui:VisualElement name="GolemEyeIcon" class="icon-box icon-golem-eye" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column; justify-content: center;" picking-mode="Ignore">
                    <ui:Label text="Golem Eye" class="hud-text-large" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AetherSightRow" class="hud-ability-row" style="display: none;" picking-mode="Ignore">
                <ui:Label text="1" class="keycap hud-ability-key" picking-mode="Ignore"/>
                <ui:VisualElement class="hud-ability-frame" picking-mode="Ignore">
                    <ui:VisualElement name="AetherSightIcon" class="icon-box icon-aether-sight" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: column;" picking-mode="Ignore">
                    <ui:Label text="Aether Sight" class="hud-text-large" picking-mode="Ignore"/>
                    <ui:Label name="AetherFocusCostText" text="OFF — Press [1]" class="hud-text-small" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Bottom-Right: Desk / Board -->
        <ui:VisualElement name="BottomRightPanel" class="hud-panel hud-bottom-right" picking-mode="Ignore">
            <ui:VisualElement class="hud-shortcut-row" picking-mode="Ignore">
                <ui:Label text="Desk" class="hud-shortcut-label" picking-mode="Ignore"/>
                <ui:Button name="DeskKeyButton" text="G" class="keycap-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-shortcut-row" picking-mode="Ignore">
                <ui:Label text="Board" class="hud-shortcut-label" picking-mode="Ignore"/>
                <ui:Button name="BoardKeyButton" text="H" class="keycap-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Center Reticle & 3D Interaction Prompt -->
        <ui:VisualElement name="CenterPanel" style="position: absolute; top: 50%; left: 50%; translate: -50% -50%; align-items: center; justify-content: center;" picking-mode="Ignore">
            <ui:VisualElement style="position: absolute; width: 6px; height: 6px; background-color: black; border-radius: 3px; align-items: center; justify-content: center;" picking-mode="Ignore">
                <ui:VisualElement style="width: 4px; height: 4px; background-color: white; border-radius: 2px;" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="InteractionContainer" style="position: absolute; top: 20px; align-items: center; display: none;" picking-mode="Ignore">
                <ui:Label name="InteractionText" text="[L-Click] Inspect" style="font-size: 15px; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: black; margin-bottom: 5px;" picking-mode="Ignore"/>
                <ui:Label name="ItemDescriptionText" text="Item Description" style="font-size: 13px; color: rgb(200, 200, 200); -unity-text-outline-width: 1px; -unity-text-outline-color: black; max-width: 400px; white-space: normal; -unity-text-align: middle-center;" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
