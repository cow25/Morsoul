<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Dialogue.uss"/>
    <ui:VisualElement name="Dialogue-Root" class="dialogue-root" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; display: none;">
        <ui:VisualElement name="DialogueStage" class="dialogue-stage" picking-mode="Ignore">
            <ui:VisualElement name="SpeakerPortrait" class="dialogue-portrait" picking-mode="Ignore" style="display: none;"/>
            <ui:VisualElement name="DialogueBoxWrapper" class="dialogue-box-wrapper" picking-mode="Ignore">
                <ui:Label name="SpeakerLabel" text="Speaker" class="dialogue-speaker"/>
                <ui:VisualElement name="DialogueBox" class="dialogue-box">
                    <ui:VisualElement name="DialogueContent" class="dialogue-content">
                        <ui:Label name="DialogueText" text="" class="dialogue-text" style="white-space: normal;"/>
                        <ui:VisualElement name="OptionsContainer" class="dialogue-options-container" style="display: none;">
                            <ui:Button name="OptionButton0" text="" class="dialogue-option-button" style="display: none;"/>
                            <ui:Button name="OptionButton1" text="" class="dialogue-option-button" style="display: none;"/>
                            <ui:Button name="OptionButton2" text="" class="dialogue-option-button" style="display: none;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="NameInputContainer" class="dialogue-name-input-row" style="display: none;">
                            <ui:TextField name="NameInputField" class="dialogue-name-field"/>
                            <ui:Button name="NameInputConfirm" text="Confirm" class="dialogue-option-button dialogue-confirm-button"/>
                        </ui:VisualElement>
                        <ui:Label name="ContinueHint" text="(E) continue" class="dialogue-continue-hint"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="FadeOverlay" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); opacity: 0; display: none; align-items: center; justify-content: center;">
        <ui:Label name="FadeText" text="" class="dialogue-fade-text" style="font-size: 22px; color: rgb(235, 230, 220); white-space: normal; -unity-text-align: upper-center;"/>
    </ui:VisualElement>
</ui:UXML>
