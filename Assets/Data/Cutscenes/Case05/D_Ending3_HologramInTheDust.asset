  m_Name: D_Ending3_HologramInTheDust
  m_EditorClassIdentifier: Morsoul.Cutscene::Morsoul.Cutscene.CutsceneData
  id: D_Ending3_HologramInTheDust
  shots:
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: '>> AUTHORIZATION VERIFIED: DETECTIVE ARTHUR C. DAYLE

      >> STABILIZATION FORMULA: RECONSTRUCTED

      >> MANUAL OVERRIDE REQUIRED: DIRECT NEURAL / CORE ENGAGEMENT'
    captionSpeaker: System
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Arthur, no! The voltage will burn out your core! Break the link!
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: The containment seal cannot hold without a conscious anchor, Eliza... It was never a machine's duty. It was mine.
    captionSpeaker: Arthur
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: 'Three thousand years in the dark... and I remembered the cases, the evidence, the laws...

      But I had forgotten the only truth that ever mattered.

      I remember you, Elise.'
    captionSpeaker: Arthur
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Keep this safe... partner. I love you.
    captionSpeaker: Arthur
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: I've got it, Arthur. Rest now. The case is closed.
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: (Five years later. The Investigator's Guild Historical Archive. On the Chief Investigator's desk, the dormant brass optic core begins to pulse with a warm, steady golden light.)
    captionSpeaker: 
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Case file logged, Operative Cochran. Ready to submit to the magistrate?
    captionSpeaker: Holo-Arthur
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Only if you're buying coffee on the way back, Detective.
    captionSpeaker: Holo-Elise
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: (Laughing) Deal.
    captionSpeaker: Holo-Arthur
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: 'Empires fall to ash, and memory fades into myth.

      Yet through catastrophe, stone, and time...

      The soul remembers.'
    captionSpeaker: 
  nextSceneName: 
  skipToScene: 1
