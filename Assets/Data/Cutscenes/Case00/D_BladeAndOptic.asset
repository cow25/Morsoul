  m_Script: {fileID: 11500000, guid: b71d7f6f7d77720459e951f4d068c803, type: 3}
  m_Name: D_BladeAndOptic
  m_EditorClassIdentifier: Morsoul.Cutscene::Morsoul.Cutscene.CutsceneData
  id: D_BladeAndOptic
  shots:
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Stone grinds on stone. The Golem steps out of the sealed ruin and into daylight, scanning the treeline.
    captionSpeaker: 
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Hold it right there, scrap-heap! Hands where I can see them!
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: Don't play dumb. First-Age constructs don't just dig themselves out of sealed quarantine vaults after three thousand years. Who's your handler? Is the Veiled Circle pulling your strings?!
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: '[DIAGNOSTIC BEACON ACTIVE: Unit Type: Forensic & Analytical Assistance Construct. Combat Subroutines: OFFLINE. Core Identity: UNKNOWN.]'
    captionSpeaker: Golem
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: 'Forensic assistance...? You don''t have an attack core at all, do you?

      (Murmuring) Wait... that ocular frequency. Why does looking at you make my chest ache...?'
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: 'A First-Age surveyor key? You didn''t smash your way through the quarantine blast doors... you solved the manual lock mechanism.

      An ancient machine that solves logic puzzles instead of ripping heads off. If the City Watch catches you lumbering down the Imperial Road, they''ll seize you for scrap metal or sell your mana core to the Alchemist Guild.'
    captionSpeaker: Eliza
  - image: {fileID: 21300000, guid: 8c889eebdea7e514b99d349204bb85de, type: 3}
    video: {fileID: 0}
    durationSeconds: 6
    waitForInput: 1
    caption: 'A First-Age forensic construct with working optical translation... Looks like I just found myself an ancient detective.

      (Quietly, to herself) ...Why did saying that feel so natural?

      Lucky for you, the Investigator''s Guild pays bounties for sharp eyes. Name''s Eliza Astra. Let''s see what Asterveil makes of you... partner.'
    captionSpeaker: Eliza
  nextSceneName: Hub_Wilderness
  skipToScene: 1
