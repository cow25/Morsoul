%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad6b4272890c70c4eb3d3dfe4810ac24, type: 3}
  m_Name: D_Ovan_01
  m_EditorClassIdentifier: Morsoul.Dialogue::Morsoul.Dialogue.DialogueData
  id: D_Ovan_01
  nodes:
  - id: ovan_has_warrant
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: (Waves a hurried hand) "You already have the Guild storage clearance warrant, Eliza! The lower cellar grate in the Lower Market is yours to unseal. Check the vault before Ignatius turns the street upside down."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: C1_WarrantGranted
    options: []
    nextNodeId: ovan_repeat_briefed
  - id: ovan_repeat_briefed
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: '"Everything from the Consortium report is on my desk. What do you still need before heading down to the Lower Market?"'
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: C1_BriefingSeen
    options:
    - label: Inquire about the vault's security
      nextNodeId: ovan_security
      requiresFlag: 
    - label: Ask about Master Ignatius
      nextNodeId: ovan_ignatius
      requiresFlag: 
    - label: Request storage clearance (Forensic Entry Warrant)
      nextNodeId: ovan_warrant
      requiresFlag: 
    nextNodeId: ovan_greeting
  - id: ovan_greeting
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "All right, Ovan\u2014we're ready for the full dossier on the Lower Market vault incident."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: ovan_challenge
  - id: ovan_challenge
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: (Rubbing his temples over a stack of wax-sealed dispatches) "Good. The Merchant Consortium is demanding answers by noon, and this makes a clean first field contract for your new partner here."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: golem_scan
  - id: golem_scan
    speakerName: Golem
    speakerPortrait: {fileID: 0}
    text: "[OPTICAL SCAN: Guildmaster respiration elevated. Dispatches stamped 'URGENT \u2014 MUNICIPAL TREASURY'.] \"Unit ready, Guildmaster. State the parameters of the Lower Market vault breach.\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: ovan_briefing
  - id: ovan_briefing
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: "Master Alchemist Ignatius\u2019 subterranean storage vault\u2014the one holding the seasonal reserve of Greater Restoration Draughts\u2014was breached three hours before dawn. Ten thousand gold ducats worth of inventory, dissolved into thin air! Ignatius claims dark cultists used forbidden volatile magic!"
    registersClue: {fileID: 0}
    setsFlag: C1_BriefingSeen
    requiresFlag: 
    options: []
    nextNodeId: ovan_options
  - id: ovan_options
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: Review the Consortium's file and tell me what else you need.
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options:
    - label: Inquire about the vault's security
      nextNodeId: ovan_security
      requiresFlag: 
    - label: Ask about Master Ignatius
      nextNodeId: ovan_ignatius
      requiresFlag: 
    - label: Request storage clearance (Forensic Entry Warrant)
      nextNodeId: ovan_warrant
      requiresFlag: 
    nextNodeId: 
  - id: ovan_security
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: "According to the Consortium registry, it\u2019s a masterwork Dwarven cylinder\u2014four tumblers, reinforced cold-iron plating, fitted into bedrock. You couldn't crack it with a siege ram. Only two keys exist: Master Ignatius carries one on his personal brass chain, and the duplicate stays sealed in Consortium archives under wax. The archive seal was never touched!"
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: golem_conclusion
  - id: golem_conclusion
    speakerName: Golem
    speakerPortrait: {fileID: 0}
    text: 'Conclusion: Entry through the perimeter door requires an authentic physical key for non-destructive ingress.'
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: eliza_registry
  - id: eliza_registry
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "(Smirks) \"Locked from the outside without a scratch on the door... Sounds cozy. We\u2019ll take a copy of the key registry record for our file.\""
    registersClue: {fileID: 11400000, guid: d0bad7376d47ec54d996f4a33840af2c, type: 2}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: ovan_options
  - id: ovan_ignatius
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: "He\u2019s barricaded in his parlor down in the Lower Market, practically having apoplexy and demanding emergency compensation from the City Commercial Treasury before the noon bell! If the Council doesn't reimburse him, he threatens to pull all apothecary trade from Asterveil."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: eliza_hurry
  - id: eliza_hurry
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "He\u2019s quick to demand municipal gold for a crime that barely cooled down. {PlayerName}, once we grab the warrant, we need to inspect that vault before his apprentices sweep away the truth."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: ovan_options
  - id: ovan_warrant
    speakerName: Guildmaster Ovan
    speakerPortrait: {fileID: 0}
    text: "(Sighs, stamping a Guild parchment with his heavy bronze seal) \"Take the Forensic Entry Warrant. Bailiff at the cellar grate will let you down into the Lower Market vault\u2014but watch your step, the whole alley still reeks of strange smoke.\""
    registersClue: {fileID: 0}
    setsFlag: C1_WarrantGranted
    requiresFlag: 
    options: []
    nextNodeId: warrant_close
  - id: warrant_close
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "Warrant stamped and sealed. Head downstairs when you're ready, {PlayerName}\u2014let's see what Ignatius' vault is really hiding."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: 
  startNodeId: ovan_has_warrant
  portraits: []
