  m_Script: {fileID: 11500000, guid: ad6b4272890c70c4eb3d3dfe4810ac24, type: 3}
  m_Name: D_ForestBarks_03
  m_EditorClassIdentifier: Morsoul.Dialogue::Morsoul.Dialogue.DialogueData
  id: D_ForestBarks_03
  nodes:
  - id: bark_1
    speakerName: Forest Ranger
    speakerPortrait: {fileID: 0}
    text: "The wild spirits aren't singing anymore\u2014they\u2019re wailing. Three woodcutters were mauled at the perimeter yesterday because the tree-guardians have gone completely feral with pain."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: bark_2
  - id: bark_2
    speakerName: Desperate Dryad Acolyte
    speakerPortrait: {fileID: 0}
    text: "Look at the soil... It\u2019s turning into dry gray ash. The Elder Tree has anchored this grove for ten thousand years. A tree like that doesn't just starve in a week!"
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: bark_3
  - id: bark_3
    speakerName: Guild Surveyor Courier
    speakerPortrait: {fileID: 0}
    text: "They\u2019re saying the sap is draining straight through the bedrock. If the Great Root dies, the sinkhole will swallow the eastern highway whole."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: 
  startNodeId: bark_1
  portraits: []
