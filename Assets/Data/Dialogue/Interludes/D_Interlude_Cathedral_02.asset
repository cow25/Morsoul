  m_Script: {fileID: 11500000, guid: ad6b4272890c70c4eb3d3dfe4810ac24, type: 3}
  m_Name: D_Interlude_Cathedral_02
  m_EditorClassIdentifier: Morsoul.Dialogue::Morsoul.Dialogue.DialogueData
  id: D_Interlude_Cathedral_02
  nodes:
  - id: sylvan_welcome
    speakerName: Acolyte Sylvan
    speakerPortrait: {fileID: 0}
    text: '"The cloister holds prayers for you both every evening. I am... welcome here again. Because of you."'
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: lyra_thanks
  - id: lyra_thanks
    speakerName: High Priestess Lyra
    speakerPortrait: {fileID: 0}
    text: (a breath) "You. The machine. And the light-stepper. Thank you."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: eliza_voice
  - id: eliza_voice
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: '"Save the voice, Lady. We don''t need speeches."'
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: lyra_hums
  - id: lyra_hums
    speakerName: High Priestess Lyra
    speakerPortrait: {fileID: 0}
    text: (a faint smile) "Then hear this. The tower... still hums. At night."
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: sylvan_belfry
  - id: sylvan_belfry
    speakerName: Acolyte Sylvan
    speakerPortrait: {fileID: 0}
    text: "\"She means the belfry. The brothers hear it too\u2014a note under the silence, where the dark soot used to ring.\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: eliza_hums
  - id: eliza_hums
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "(already turning toward the stairwell) \"Hums don't happen for nothing. Come on, {PlayerName}\u2014let's see what your eyes can find up there now.\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: 
  startNodeId: sylvan_welcome
  portraits: []
