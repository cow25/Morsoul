  id: D_Guild_Reception
  nodes:
  - id: eliza_desk
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: "\"Front desk is Marta \u2014 the Guild clerk. Every open job in Asterveil passes her board. Best eyes in the city for who's hiring.\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: marta_shock
  - id: marta_shock
    speakerName: Marta
    speakerPortrait: {fileID: 0}
    text: "\"Back from the ruins already, Eliza? And you've brought\u2014 oh. Oh my. What in the Saints' name is THAT?\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: eliza_vouch
  - id: eliza_vouch
    speakerName: Eliza
    speakerPortrait: {fileID: 0}
    text: '"A friend, Marta. A very strange friend. We''re going up to see Ovan."'
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: marta_stairs
  - id: marta_stairs
    speakerName: Marta
    speakerPortrait: {fileID: 0}
    text: "\"Well\u2014 he's in his office, upstairs at the end of the hall. Do try not to let it break anything.\""
    registersClue: {fileID: 0}
    setsFlag: 
    requiresFlag: 
    options: []
    nextNodeId: 
  startNodeId: eliza_desk
  portraits: []
