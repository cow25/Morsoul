  slotB: {fileID: 11400000, guid: 052604a5970f0234a8ee427ae48dfeb5, type: 2}
  prompt:
    question: The logs mark this place as a mana research installation, and the door's power relay burned out in an emergency overload. What does this establish?
    options:
    - Someone sealed the doors from outside to trap whoever remained.
    - A catastrophic overload cut the power, leaving the security doors locked in an unpowered failsafe.
    - The doors are still powered and will open once the facility reboots.
    correctIndex: 1
    hintText: 'Diagnostic note: crystallized mana slag forms only during an overload. A door that has lost its power does not open. It holds in failsafe.'
  producesPremise: {fileID: 11400000, guid: eed14f4547c2aa1469a9a5382041da45, type: 2}
  rejectedClues:
