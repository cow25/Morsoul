%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 20110e2d39e081f4fac5bf238f842405, type: 3}
  m_Name: INT_01
  m_EditorClassIdentifier: Morsoul.Data::Morsoul.Data.InterrogationData
  id: INT_01
  suspectName: Master Alchemist Ignatius
  composureSegments: 3
  falsehoodShieldActive: 1
  phases:
  - suspectClaim: An unknown cabal breached my inner vault using volatile dark magic! You cannot hold me accountable for catastrophic supernatural sabotage!
    keywords:
    - volatile dark magic
    validMoves:
    - verb: 0
      evidence: {fileID: 0}
      breaksComposureSegment: 0
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: The vapors were purple, acrid, and dissolved the vats in seconds! Only forbidden sorcery works that fast!
      emotionAura: 0
    - verb: 1
      evidence: {fileID: 11400000, guid: bd6194f06c3e4a94890682502e0d7f2b, type: 2}
      breaksComposureSegment: 1
      strikeCost: 0
      isCoreContradiction: 1
      responseDialogue: Spectral analysis detected synthetic solvent sublimation, not necromancy or dark magic. The smoke was a theatrical irritant.
      emotionAura: 0
    - verb: 1
      evidence: {fileID: 11400000, guid: d2b6c136916cd1949b186fe75d9144f1, type: 2}
      breaksComposureSegment: 1
      strikeCost: 0
      isCoreContradiction: 1
      responseDialogue: "An unmarked crate stacked right outside your own workshop carries the exact same purple-film solvent. You didn't suffer a dark-magic ambush \u2014 you received a delivery."
      emotionAura: 0
    invalidMoves: []
  - suspectClaim: Even if mundane solvent was used, some skilled cat burglar must have jimmied the locks from the back alley while Asterveil slept!
    keywords:
    - jimmied the locks from the back alley
    validMoves:
    - verb: 0
      evidence: {fileID: 0}
      breaksComposureSegment: 0
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: I lock up strictly at the eighth bell! Any thief with a standard pick-set could slip past the sleepy market watch and force the cylinder!
      emotionAura: 0
    - verb: 2
      evidence: {fileID: 11400000, guid: 0066f2bffa0259746805d3019de693ea, type: 2}
      breaksComposureSegment: 1
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: "The cylinder pins bear no scratches, and the Guild holds the only duplicate. That substantiates a single conclusion \u2014 the door was opened with a registered key, and only yours and the Guildmaster's exist. So whose key turned it?"
      emotionAura: 0
    invalidMoves:
    - verb: 2
      evidence: {fileID: 11400000, guid: 9ab9923cb8f7c9649b70f0ce62f858a3, type: 2}
      breaksComposureSegment: 0
      strikeCost: 1
      isCoreContradiction: 0
      responseDialogue: That crude wire? That wouldn't turn a tavern padlock, let alone dwarven masterwork steel! You are grasping at straws, automaton!
      emotionAura: 0
  - suspectClaim: This is absurd! Why would I destroy ten thousand gold ducats worth of inventory? I am financially ruined by this loss!
    keywords:
    - financially ruined by this loss
    validMoves:
    - verb: 0
      evidence: {fileID: 0}
      breaksComposureSegment: 0
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: My entire life's work, my retirement, my family's trust fund was tied into Batch #408! If the City Treasury does not approve my emergency compensation by noon, I am bankrupt!
      emotionAura: 0
    - verb: 1
      evidence: {fileID: 11400000, guid: b564b4ab52aadf14dad45e9fa97861a4, type: 2}
      breaksComposureSegment: 1
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: You destroyed nothing of value. Batch records confirm shipment #408 was never bottled. You staged an attack to collect guild insurance on phantom goods.
      emotionAura: 0
    - verb: 1
      evidence: {fileID: 11400000, guid: 6b5d70b95a5034b429c93992914bb255, type: 2}
      breaksComposureSegment: 1
      strikeCost: 0
      isCoreContradiction: 0
      responseDialogue: "You pre-signed a Treasury indemnity claim for Batch #408 two full days before the breach even occurred. You weren't ruined by an attack \u2014 you scheduled it."
      emotionAura: 0
    invalidMoves: []
