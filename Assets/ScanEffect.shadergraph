{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "4297b4994a3749b4937d2bea2f54ce85",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "EdgeDetect (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1335.0001220703125,
            "y": -273.0,
            "width": 221.0001220703125,
            "height": 118.00001525878906
        }
    },
    "m_Slots": [
        {
            "m_Id": "3c340de74d08414a87a1d45ced213434"
        },
        {
            "m_Id": "6bce91952a164c318c29b8821b99e653"
        },
        {
            "m_Id": "1a86ebabfe934ce9971c72e5fcafc1f8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "EdgeDetect",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float depth1 = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV);\r\nfloat depth2 = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(Thickness, 0));\r\nfloat depth3 = SHADERGRAPH_SAMPLE_SCENE_DEPTH(UV + float2(0, Thickness));\r\n\r\nfloat edgeX = abs(depth1 - depth2);\r\nfloat edgeY = abs(depth1 - depth3);\r\n\r\nOut = saturate((edgeX + edgeY) * 100.0);"
}

