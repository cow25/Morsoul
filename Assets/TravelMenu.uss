.travel-menu-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    background-color: rgba(10, 9, 8, 0.55);
}

.travel-menu-box {
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 46px 58px 40px 58px;
    border-width: 0;
}

.travel-menu-title {
    font-size: 20px;
    color: rgb(32, 22, 14);
    text-shadow: 0 0 0 transparent;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.travel-destination {
    white-space: normal;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(238, 226, 200);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(112, 82, 48, 0.45);
    border-radius: 4px;
    margin-top: 6px;
    padding: 9px 14px;
    font-size: 16px;
    color: rgb(30, 20, 14);
    -unity-text-align: middle-left;
}

.travel-destination--selected {
    -unity-background-image-tint-color: rgb(246, 214, 142);
    border-color: rgb(146, 98, 24);
    border-width: 2px;
    -unity-font-style: bold;
}

.travel-menu-hint {
    font-size: 13px;
    color: rgb(72, 54, 38);
    text-shadow: 0 0 0 transparent;
    margin-top: 8px;
}
