.dialogue-root {
    -unity-font-definition: url("project://database/Assets/Fonts/EBGaramond.ttf");
}

.dialogue-stage {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 4%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.dialogue-portrait {
    width: 196px;
    height: 196px;
    margin-bottom: -8px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: rgba(18, 14, 12, 0.85);
    border-color: rgba(206, 168, 108, 0.75);
    border-width: 2px;
    border-radius: 8px;
}

.dialogue-portrait--crystal {
    border-color: rgba(80, 224, 248, 0.95);
    background-color: rgba(10, 28, 40, 0.92);
}

.dialogue-box-wrapper {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
}

.dialogue-speaker {
    font-size: 22px;
    color: rgb(252, 246, 234);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin-left: 14px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.dialogue-speaker--crystal {
    color: rgb(118, 238, 255);
}

.dialogue-box {
    width: 100%;
    min-height: 150px;
    background-color: rgba(26, 20, 16, 0.90);
    border-color: rgba(206, 168, 108, 0.65);
    border-width: 1.5px;
    border-radius: 10px;
    padding: 18px 24px 14px 24px;
}

.dialogue-box--crystal {
    background-color: rgba(10, 22, 34, 0.92);
    border-color: rgba(80, 224, 248, 0.88);
    border-width: 2px;
}

.dialogue-content {
    flex-grow: 1;
    flex-direction: column;
}

.dialogue-text {
    font-size: 18px;
    color: rgb(246, 240, 228);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
    margin-bottom: 6px;
}

.dialogue-options-container {
    flex-shrink: 0;
    margin-top: 8px;
    flex-direction: column;
}

.dialogue-option-button {
    white-space: normal;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgba(242, 238, 230, 0.96);
    background-color: transparent;
    border-width: 0;
    border-radius: 5px;
    padding: 9px 16px;
    margin-top: 6px;
    color: rgb(24, 22, 20);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.dialogue-option-button:hover {
    -unity-background-image-tint-color: rgb(255, 238, 198);
    color: rgb(18, 14, 10);
}

.dialogue-option-button:active {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_3.png");
    -unity-background-image-tint-color: rgb(245, 220, 165);
}

.dialogue-name-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    flex-shrink: 0;
}

.dialogue-name-field {
    flex-grow: 1;
    font-size: 16px;
}

.dialogue-name-field > .unity-base-text-field__input {
    background-color: rgba(248, 244, 236, 0.96);
    color: rgb(24, 22, 20);
    border-color: rgba(95, 78, 56, 0.7);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
}

.dialogue-confirm-button {
    margin-left: 8px;
    margin-top: 0;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    min-width: 100px;
}

.dialogue-continue-hint {
    font-size: 13px;
    color: rgba(58, 50, 44, 0.85);
    -unity-text-align: middle-right;
    margin-top: auto;
    padding-top: 6px;
    flex-shrink: 0;
}

.dialogue-fade-text {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
}
