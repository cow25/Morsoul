.title-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Assets/Art/UI/Title_Study_Bg.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
}

.title-header {
    position: absolute;
    left: 6.8%;
    top: 10.5%;
    flex-direction: column;
}

.title-logo {
    font-size: 66px;
    color: rgb(230, 199, 97);
    -unity-font-style: bold;
    white-space: nowrap;
    text-shadow: 2px 3px 4px rgba(0, 0, 0, 0.72);
    margin: 0;
    padding: 0;
}

.title-subtitle {
    font-size: 22px;
    color: rgb(201, 166, 74);
    white-space: nowrap;
    margin-top: -6px;
    margin-left: 6px;
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.72);
}

.title-menu-stack {
    position: absolute;
    left: 7.4%;
    top: 49%;
    flex-direction: column;
    align-items: flex-start;
}

.title-menu-row {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 6px;
}

.title-menu-btn-line {
    flex-direction: row;
    align-items: center;
}

.title-menu-btn {
    background-color: transparent;
    border-width: 0;
    padding: 4px 10px 4px 2px;
    margin: 0;
    font-size: 23px;
    color: rgb(245, 240, 227);
    -unity-text-align: middle-left;
    text-shadow: 1px 2px 3px rgba(0, 0, 0, 0.85);
}

.title-menu-btn:hover {
    color: rgb(245, 222, 138);
}

.title-menu-btn:disabled {
    color: rgba(185, 174, 158, 0.42);
}

.title-menu-row--active .title-menu-btn {
    color: rgb(230, 199, 97);
}

.title-menu-diamond {
    width: 10px;
    height: 10px;
    margin-left: 8px;
    background-color: rgb(230, 199, 97);
    rotate: 45deg;
    opacity: 0;
}

.title-menu-row--active .title-menu-diamond {
    opacity: 1;
}

.title-menu-underline {
    height: 2px;
    width: 100%;
    min-width: 130px;
    margin-top: 1px;
    background-color: rgba(230, 199, 97, 0.85);
    opacity: 0;
}

.title-menu-row--active .title-menu-underline {
    opacity: 1;
}

.title-credit {
    position: absolute;
    left: 6.8%;
    bottom: 4.5%;
    font-size: 13px;
    color: rgba(186, 166, 138, 0.56);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.85);
}

/* Shared Modal Backdrop */
.title-modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 5, 8, 0.72);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.title-modal-header {
    font-size: 24px;
    color: rgb(245, 240, 227);
    margin-bottom: 10px;
    text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.85);
}

/* Save Slots Ornate Container */
.save-card-frame {
    width: 700px;
    max-width: 92%;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(168, 152, 130);
    padding: 52px 72px 48px 72px;
    align-items: center;
    justify-content: center;
}

.save-slots-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.tarot-card {
    width: 162px;
    height: 256px;
    margin: 0 10px;
    padding: 14px 10px;
    background-color: rgb(22, 20, 24);
    border-color: rgba(214, 184, 108, 0.78);
    border-width: 2px;
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

.tarot-card:hover {
    border-color: rgb(248, 222, 146);
    scale: 1.02 1.02;
}

.tarot-card--populated {
    background-color: rgb(166, 138, 54);
    border-color: rgb(242, 212, 126);
}

.tarot-title {
    font-size: 16px;
    color: rgb(246, 224, 146);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.75);
}

.tarot-card--populated .tarot-title {
    color: rgb(28, 20, 12);
    text-shadow: 0 0 0 transparent;
}

.tarot-portrait {
    width: 108px;
    height: 128px;
    background-image: url("project://database/Assets/Art/UI/Golem_Portrait.png");
    -unity-background-scale-mode: scale-to-fit;
}

.tarot-subtitle {
    font-size: 13px;
    color: rgb(228, 218, 198);
    -unity-text-align: middle-center;
    white-space: normal;
}

.tarot-card--populated .tarot-subtitle {
    color: rgb(24, 18, 12);
    -unity-font-style: bold;
}

.save-status-label {
    font-size: 15px;
    color: rgb(236, 204, 114);
    margin-top: 10px;
    min-height: 22px;
}

/* Ornate Buttons */
.title-parchment-btn {
    min-width: 170px;
    min-height: 38px;
    padding: 6px 20px;
    margin-top: 8px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(236, 222, 192);
    background-color: transparent;
    border-width: 0;
    color: rgb(30, 22, 14);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.title-parchment-btn:hover {
    -unity-background-image-tint-color: rgb(255, 242, 208);
}

/* Overwrite Prompt */
.overwrite-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 5, 8, 0.56);
    align-items: center;
    justify-content: center;
}

.overwrite-card {
    width: 340px;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 40px 52px 36px 52px;
    align-items: center;
    flex-direction: column;
}

.overwrite-title {
    font-size: 19px;
    color: rgb(28, 20, 14);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* Settings Modal Card */
.settings-card {
    width: 600px;
    max-width: 92%;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 48px 72px 42px 72px;
    flex-direction: column;
}

.settings-card-title {
    font-size: 21px;
    color: rgb(28, 20, 14);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.settings-label {
    width: 132px;
    font-size: 15px;
    color: rgb(32, 24, 18);
}

.settings-bar-wrap {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.settings-step-btn {
    width: 28px;
    height: 26px;
    padding: 0;
    margin: 0 5px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Frame01a.png");
    -unity-background-image-tint-color: rgb(222, 206, 174);
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    color: rgb(28, 22, 16);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.settings-step-btn:hover {
    -unity-background-image-tint-color: rgb(246, 232, 198);
}

.settings-track {
    flex-grow: 1;
    height: 15px;
    padding: 2px;
    background-color: rgba(226, 218, 202, 0.92);
    border-color: rgb(88, 70, 50);
    border-width: 1px;
    border-radius: 3px;
}

.settings-fill {
    height: 100%;
    background-color: rgb(130, 80, 160);
    border-radius: 2px;
}

.settings-val {
    width: 48px;
    font-size: 14px;
    color: rgb(42, 32, 22);
    -unity-text-align: middle-right;
}

.settings-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
}

