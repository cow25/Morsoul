.title-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    background-color: rgba(10, 8, 14, 1);
    align-items: center;
    justify-content: center;
}

.title-column {
    width: 340px;
    align-items: center;
}

.title-label {
    font-size: 64px;
    -unity-font-style: bold;
    color: white;
    text-shadow: 2px 2px 4px black;
    -unity-text-align: middle-center;
}

.subtitle-label {
    font-size: 20px;
    color: rgb(185, 165, 205);
    text-shadow: 1px 1px 2px black;
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 36px;
}

.title-name-field {
    width: 100%;
    height: 40px;
    margin-bottom: 16px;
    font-size: 15px;
    color: white;
    background-color: rgba(30, 26, 38, 0.9);
    border-color: rgba(255, 255, 255, 0.35);
    border-width: 1px;
    border-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
}

.title-name-field:focus {
    border-color: rgb(130, 80, 160);
}

.title-button {
    width: 100%;
    height: 44px;
    margin-top: 8px;
    background-color: rgba(48, 38, 62, 0.9);
    border-color: rgb(130, 80, 160);
    border-width: 1px;
    border-radius: 6px;
    color: white;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.title-button:hover {
    background-color: rgba(72, 55, 94, 0.95);
    border-color: rgb(165, 120, 195);
}

.title-button--disabled {
    color: rgba(255, 255, 255, 0.4);
    background-color: rgba(30, 26, 38, 0.5);
    border-color: rgba(255, 255, 255, 0.15);
}
