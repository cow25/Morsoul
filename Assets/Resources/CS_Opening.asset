    video: {fileID: 0}
    durationSeconds: 0
    waitForInput: 1
    caption: ">> CORE RE-INITIALIZATION: OK.\n>> WARNING: MEMORY SECTORS 01\u201399 CORRUPTED.\n>> CHASSIS INTEGRITY: 84%. OPTICAL SENSORS: ONLINE."
