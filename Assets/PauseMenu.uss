.pause-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    -unity-font-definition: url("project://database/Assets/Fonts/EBGaramond.ttf");
}

.pause-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 6, 10, 0.70);
}

.pause-stack {
    width: 700px;
    max-width: 94%;
    max-height: 96%;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}

.pause-card {
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 26px 68px 22px 72px;
    margin-bottom: 4px;
    flex-shrink: 1;
}

.pause-card-bottom {
    margin-bottom: 0;
    padding: 24px 68px 22px 72px;
}

.pause-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.pause-card-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    font-size: 16px;
    color: rgb(32, 24, 18);
    -unity-font-style: bold;
}

.pause-card-subtitle {
    font-size: 13px;
    color: rgb(62, 48, 36);
}

/* Dossier layout */
.dossier-body {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.dossier-fields {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    margin-right: 12px;
}

.dossier-col {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
    width: 48%;
    margin-right: 12px;
}

.dossier-field {
    margin-bottom: 3px;
}

.dossier-label {
    font-size: 11px;
    color: rgb(68, 52, 36);
    -unity-font-style: bold;
    margin-bottom: 0;
}

.dossier-value {
    font-size: 13px;
    color: rgb(22, 16, 10);
    white-space: normal;
}

.dossier-row-inline {
    flex-direction: row;
    justify-content: flex-start;
}

.rep-track {
    width: 100%;
    max-width: 136px;
    height: 11px;
    margin-top: 2px;
    padding: 2px;
    background-color: rgb(236, 232, 224);
    border-color: rgb(62, 50, 38);
    border-width: 1px;
    border-radius: 2px;
}

.rep-fill {
    height: 100%;
    background-color: rgb(88, 152, 72);
    border-radius: 1px;
}

.rep-points {
    width: 100%;
    max-width: 136px;
    font-size: 11px;
    color: rgb(48, 38, 26);
    -unity-text-align: middle-right;
    margin-top: 1px;
}

.dossier-portrait-col {
    width: 102px;
    align-items: center;
    flex-shrink: 0;
}

.dossier-portrait-frame {
    width: 86px;
    height: 100px;
    padding: 4px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_FrameSlot03a.png");
    -unity-background-image-tint-color: rgb(95, 76, 52);
    -unity-background-scale-mode: stretch-to-fill;
}

.dossier-portrait-img {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Art/UI/Golem_Portrait.png");
    -unity-background-scale-mode: scale-and-crop;
}

.dossier-motto {
    font-size: 10px;
    color: rgb(42, 34, 24);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* Actions Grid */
.pause-actions-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.pause-action-col {
    flex-direction: column;
    width: 48%;
}

.pause-action-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    margin-bottom: 4px;
    padding: 3px 10px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(238, 226, 200);
    background-color: transparent;
    border-width: 0;
    color: rgb(28, 22, 16);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.pause-action-btn:hover {
    -unity-background-image-tint-color: rgb(252, 240, 212);
    color: rgb(16, 12, 8);
}

.pause-action-btn-secondary {
    min-height: 28px;
    padding: 3px 12px;
    margin-right: 8px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(222, 206, 174);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 24, 18);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.pause-action-btn-secondary:hover {
    -unity-background-image-tint-color: rgb(248, 234, 202);
}

.pause-status {
    font-size: 12px;
    color: rgb(52, 108, 48);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* Settings page */
.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.settings-label {
    width: 125px;
    font-size: 13px;
    color: rgb(32, 24, 18);
}

.settings-bar-wrap {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.settings-step-btn {
    width: 24px;
    height: 22px;
    padding: 0;
    margin: 0 4px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Frame01a.png");
    -unity-background-image-tint-color: rgb(218, 202, 172);
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0;
    color: rgb(28, 22, 16);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.settings-track {
    flex-grow: 1;
    height: 14px;
    padding: 2px;
    background-color: rgba(226, 218, 202, 0.92);
    border-color: rgb(88, 70, 50);
    border-width: 1px;
    border-radius: 3px;
}

.settings-fill {
    height: 100%;
    background-color: rgb(130, 80, 160);
    border-radius: 2px;
}

.settings-val {
    width: 46px;
    font-size: 13px;
    color: rgb(44, 34, 24);
    -unity-text-align: middle-right;
}

.quit-confirm-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
}

.pause-action-btn--wide {
    margin-top: 2px;
    margin-bottom: 4px;
}

/* Tutorial Logs subpage */
.tut-log-filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.tut-log-filter-btn {
    background-color: rgba(226, 212, 182, 0.72);
    border-color: rgba(98, 74, 46, 0.45);
    border-width: 1px;
    border-radius: 3px;
    padding: 2px 7px;
    margin-right: 4px;
    margin-bottom: 3px;
    font-size: 11px;
    color: rgb(38, 28, 18);
}

.tut-log-filter-btn--active {
    background-color: rgba(186, 146, 78, 0.85);
    border-color: rgb(88, 58, 22);
    color: rgb(22, 14, 8);
    -unity-font-style: bold;
}

.tut-log-split {
    flex-direction: row;
    height: 126px;
}

.tut-log-list {
    width: 44%;
    margin-right: 8px;
    background-color: rgba(232, 220, 194, 0.55);
    border-color: rgba(98, 74, 46, 0.35);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px;
}

.tut-log-item {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(98, 74, 46, 0.2);
    padding: 4px 6px;
    margin-bottom: 2px;
    font-size: 12px;
    color: rgb(32, 22, 14);
    white-space: normal;
    -unity-text-align: middle-left;
}

.tut-log-item--selected {
    background-color: rgba(168, 128, 68, 0.28);
    -unity-font-style: bold;
}

.tut-log-item--locked {
    color: rgb(118, 102, 84);
}

.tut-log-detail {
    flex-grow: 1;
    background-color: rgba(238, 228, 206, 0.72);
    border-color: rgba(98, 74, 46, 0.35);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 8px;
}

.tut-log-detail-title {
    font-size: 14px;
    color: rgb(28, 18, 10);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 3px;
}

.tut-log-detail-keys {
    font-size: 11px;
    color: rgb(114, 70, 22);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.tut-log-detail-body {
    font-size: 12px;
    color: rgb(36, 26, 18);
    white-space: normal;
}
