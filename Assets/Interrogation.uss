.interrogation-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
}

.hud-text-large {
    font-size: 18px;
    color: white;
    text-shadow: 1px 1px 2px black;
    -unity-font-style: bold;
}

.hud-text {
    font-size: 16px;
    color: white;
    text-shadow: 1px 1px 2px black;
}

.hud-text-small {
    font-size: 12px;
    text-shadow: 1px 1px 1px black;
    color: rgb(200, 200, 200);
}

.interrogation-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.interrogation-panel {
    background-color: rgba(14, 11, 18, 0.94);
    border-color: rgba(255, 255, 255, 0.35);
    border-width: 1px;
    border-radius: 8px;
    padding: 14px 18px;
}

/* --- Composure segments ------------------------------------------------ */

.composure-segment {
    width: 42px;
    height: 14px;
    margin-left: 4px;
    background-color: rgb(229, 169, 60);
    border-color: rgba(255, 230, 170, 0.9);
    border-width: 1px;
    border-radius: 3px;
}

.segment--shielded {
    background-color: rgb(130, 80, 160);
    border-color: rgb(198, 166, 226);
    border-width: 2px;
}

.segment--broken {
    background-color: rgba(80, 60, 40, 0.4);
    border-color: rgba(140, 110, 80, 0.35);
    border-width: 1px;
}

/* --- Strike seals ------------------------------------------------------- */

.strike-seal {
    width: 16px;
    height: 16px;
    margin-left: 5px;
    background-color: rgb(160, 48, 48);
    border-color: rgba(220, 140, 140, 0.8);
    border-width: 1px;
    border-radius: 8px;
}

.strike-seal--lost {
    background-color: rgba(50, 24, 24, 0.6);
    border-color: rgba(120, 60, 60, 0.3);
}

/* --- Claim area ---------------------------------------------------------- */

.claim-area {
    background-color: rgba(24, 19, 32, 0.8);
    border-color: rgba(255, 255, 255, 0.18);
    border-width: 1px;
    border-radius: 6px;
    padding: 12px;
}

.portrait {
    width: 110px;
    height: 140px;
    flex-shrink: 0;
    background-color: rgba(10, 8, 14, 0.9);
    border-color: rgba(255, 255, 255, 0.35);
    border-width: 2px;
    border-radius: 6px;
}

.portrait--amber {
    border-color: rgb(192, 138, 60);
    border-width: 3px;
}

.portrait--violet {
    border-color: rgb(130, 80, 160);
    border-width: 3px;
}

.portrait--crimson {
    border-color: rgb(160, 48, 48);
    border-width: 3px;
}

.claim-text {
    font-size: 16px;
    color: white;
    text-shadow: 1px 1px 2px black;
}

.keyword-button {
    background-color: rgba(40, 32, 52, 0.85);
    border-color: rgba(255, 255, 255, 0.2);
    border-width: 1px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(229, 169, 60);
    border-radius: 4px;
    color: rgb(229, 169, 60);
    font-size: 14px;
    padding: 4px 10px;
    margin-right: 8px;
    margin-top: 4px;
    -unity-font-style: bold;
}

.keyword-button:hover {
    background-color: rgba(64, 52, 84, 0.95);
    border-color: rgb(229, 169, 60);
    border-bottom-color: rgb(255, 205, 110);
    color: rgb(255, 205, 110);
}

.keyword--pressed {
    color: rgb(255, 220, 150);
    background-color: rgba(70, 55, 40, 0.9);
    border-bottom-color: rgb(255, 220, 150);
}

.keyword--amber {
    border-bottom-color: rgb(192, 138, 60);
    text-shadow: 0 0 6px rgba(192, 138, 60, 0.8);
}

.keyword--violet {
    border-bottom-color: rgb(130, 80, 160);
    color: rgb(198, 166, 226);
    text-shadow: 0 0 6px rgba(130, 80, 160, 0.8);
}

.response-text {
    font-size: 14px;
    color: rgb(210, 195, 225);
    -unity-font-style: italic;
}

/* --- Stances ------------------------------------------------------------- */

.stance-button {
    height: 40px;
    flex-grow: 1;
    margin-right: 10px;
    background-color: rgba(30, 26, 38, 0.9);
    border-color: rgba(255, 255, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(190, 190, 190);
    font-size: 14px;
    -unity-font-style: bold;
}

.stance-button:hover {
    background-color: rgba(52, 45, 66, 0.95);
    border-color: rgba(255, 255, 255, 0.55);
    color: white;
}

.stance--selected {
    border-color: rgb(229, 169, 60);
    border-width: 2px;
    color: rgb(229, 169, 60);
    background-color: rgba(58, 46, 32, 0.9);
}

/* --- Evidence tray -------------------------------------------------------- */

.evidence-tray {
    border-color: rgba(255, 255, 255, 0.18);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
    background-color: rgba(20, 16, 28, 0.85);
}

.evidence-card {
    width: 170px;
    height: 96px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgba(30, 26, 38, 0.85);
    border-color: rgba(255, 255, 255, 0.35);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
    margin: 4px;
}

.evidence-card:hover {
    background-color: rgba(52, 45, 66, 0.92);
    border-color: rgb(229, 169, 60);
}

.evidence-card-name {
    font-size: 13px;
    color: white;
    text-shadow: 1px 1px 1px black;
    white-space: normal;
    flex-grow: 1;
}

.evidence-card-type {
    font-size: 11px;
    color: rgb(185, 165, 205);
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* --- Banner / hints ------------------------------------------------------- */

.banner {
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 15px;
    color: white;
    text-shadow: 1px 1px 2px black;
}

.banner--error {
    background-color: rgba(96, 34, 40, 0.75);
    border-color: rgba(190, 95, 100, 0.8);
}

.banner--info {
    background-color: rgba(35, 60, 48, 0.75);
    border-color: rgba(110, 160, 125, 0.8);
}

.guided-hint {
    font-size: 13px;
    color: rgb(198, 166, 226);
    -unity-font-style: italic;
}

/* --- End overlay ---------------------------------------------------------- */

.end-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.82);
    align-items: center;
    justify-content: center;
}

.end-label {
    font-size: 34px;
    color: rgb(229, 169, 60);
    text-shadow: 2px 2px 4px black;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* --- Mistrial retry modal -------------------------------------------------- */

.mistrial-modal {
    width: 520px;
    max-width: 80%;
    background-color: rgba(18, 14, 24, 0.97);
    border-color: rgb(229, 169, 60);
    border-width: 2px;
    border-radius: 8px;
    padding: 26px 32px;
    align-items: center;
}

.mistrial-label {
    font-size: 30px;
    color: rgb(229, 169, 60);
    text-shadow: 2px 2px 4px black;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mistrial-sub {
    font-size: 15px;
    color: rgb(210, 195, 225);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 10px;
}

.retry-button {
    height: 42px;
    margin-top: 22px;
    padding-left: 22px;
    padding-right: 22px;
    background-color: rgba(58, 46, 32, 0.9);
    border-color: rgb(229, 169, 60);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(229, 169, 60);
    font-size: 15px;
    -unity-font-style: bold;
}

.retry-button:hover {
    background-color: rgba(82, 64, 42, 0.95);
    border-color: rgb(255, 205, 110);
    color: rgb(255, 205, 110);
}
