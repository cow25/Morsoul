<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Board.uss"/>
    <ui:VisualElement name="Board-Root" class="board-root" style="position: absolute; width: 100%; height: 100%; display: none;">
        <ui:VisualElement name="BoardPanel" class="board-panel">
            <ui:VisualElement name="HeaderRow" class="board-header-row">
                <ui:Button name="CloseBoardButton" text="← Back  [H]" class="board-back-button"/>
                <ui:Label name="CaseTitleLabel" text="Case Investigation" class="board-title"/>
            </ui:VisualElement>

            <ui:Label name="RackHeader" text="Pinned Evidence — Select two clues to test a causal link" class="board-section-label"/>
            <ui:ScrollView name="ClueRack" mode="Horizontal" class="clue-rack"/>

            <ui:VisualElement name="WorkspaceRow" class="workspace-row">
                <ui:Button name="SlotA" text="Slot A" class="slot-button"/>
                <ui:Button name="SlotB" text="Slot B" class="slot-button"/>
                <ui:Button name="LinkButton" text="Link Clues" class="link-button"/>
            </ui:VisualElement>

            <ui:Label name="PremiseHeader" text="Verified Premises (2 needed for Master Hypothesis)" class="board-section-label"/>
            <ui:VisualElement name="PremiseRow" class="premise-row"/>

            <ui:VisualElement name="FooterRow" class="board-footer-row">
                <ui:Button name="SubmitButton" text="Submit Master Hypothesis" class="submit-button submit-button--disabled"/>
            </ui:VisualElement>

            <ui:VisualElement name="FeedbackBanner" class="feedback-banner" style="display: none;">
                <ui:Label name="FeedbackLabel" text="" class="feedback-text"/>
                <ui:Label name="HintLabel" text="" class="banner--hint" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="PromptModal" class="prompt-modal" style="display: none;">
            <ui:VisualElement name="PromptCard" class="prompt-card">
                <ui:Label name="PromptQuestion" text="" class="prompt-question" style="white-space: normal;"/>
                <ui:Button name="OptionButton0" text="" class="option-button"/>
                <ui:Button name="OptionButton1" text="" class="option-button"/>
                <ui:Button name="OptionButton2" text="" class="option-button"/>
                <ui:Button name="CancelPromptButton" text="Cancel" class="cancel-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="HintPopup" class="hint-popup" style="display: none;">
            <ui:VisualElement name="HintPortrait" class="hint-portrait"/>
            <ui:VisualElement name="HintBody" class="hint-body">
                <ui:Label name="HintSpeaker" text="Eliza" class="hint-speaker"/>
                <ui:Label name="HintText" text="" class="hint-text" style="white-space: normal;"/>
                <ui:Button name="HintClose" text="Dismiss" class="hint-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
