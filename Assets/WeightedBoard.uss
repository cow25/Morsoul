.wboard-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    background-color: rgba(10, 9, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.wboard-panel {
    width: 88%;
    height: 86%;
    max-width: 1280px;
    max-height: 780px;
    background-image: url("project://database/Assets/Art/UI/Cork_Board_Panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 56px 68px 56px 68px;
    flex-direction: column;
}

.wboard-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.wboard-back-button {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 218, 188);
    background-color: transparent;
    border-width: 0;
    padding: 7px 18px;
    color: rgb(32, 22, 14);
    font-size: 14px;
    -unity-font-style: bold;
}

.wboard-back-button:hover {
    -unity-background-image-tint-color: rgb(252, 236, 198);
}

.wboard-title {
    font-size: 21px;
    color: rgb(28, 18, 12);
    -unity-font-style: bold;
    background-color: rgba(242, 228, 198, 0.88);
    border-color: rgba(104, 78, 48, 0.65);
    border-width: 1px;
    border-radius: 4px;
    padding: 5px 16px;
}

.wboard-status-badges {
    flex-direction: row;
    align-items: center;
}

.wboard-stat-pill {
    font-size: 13px;
    color: rgb(34, 24, 16);
    background-color: rgba(238, 224, 194, 0.88);
    border-color: rgba(104, 78, 48, 0.65);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 10px;
    margin-left: 8px;
}

.wboard-main-row {
    flex-grow: 1;
    flex-direction: row;
}

.wboard-canvas-column {
    flex-grow: 1;
    margin-right: 16px;
    background-color: rgba(68, 46, 26, 0.16);
    border-color: rgba(94, 66, 40, 0.35);
    border-width: 1px;
    border-radius: 6px;
    overflow: hidden;
}

.wboard-canvas {
    flex-grow: 1;
    position: relative;
}

.wboard-node {
    position: absolute;
    min-width: 138px;
    max-width: 175px;
    padding: 10px 12px;
    background-color: rgba(246, 236, 212, 0.95);
    border-color: rgba(96, 68, 40, 0.72);
    border-width: 1.5px;
    border-radius: 4px;
}

.wboard-node:hover {
    background-color: rgba(255, 246, 224, 0.99);
    border-color: rgb(146, 98, 28);
}

.wboard-node--selected {
    background-color: rgba(232, 210, 252, 0.96);
    border-color: rgb(118, 62, 152);
    border-width: 2px;
}

.wboard-node--hint {
    background-color: rgba(255, 240, 178, 0.98);
    border-color: rgb(198, 138, 28);
    border-width: 2px;
}

.wboard-node-name {
    font-size: 13px;
    color: rgb(32, 22, 14);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.wboard-side-ledger {
    width: 310px;
    flex-shrink: 0;
    background-color: rgba(242, 228, 198, 0.90);
    border-color: rgba(102, 74, 46, 0.72);
    border-width: 1.5px;
    border-radius: 6px;
    padding: 12px 14px;
    flex-direction: column;
}

.wboard-ledger-header {
    font-size: 13px;
    color: rgb(42, 28, 18);
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgba(102, 74, 46, 0.35);
    padding-bottom: 4px;
    margin-bottom: 6px;
}

.wboard-link-list {
    max-height: 155px;
    margin-bottom: 10px;
}

.wboard-link-row {
    background-color: rgba(232, 216, 184, 0.85);
    border-color: rgba(112, 82, 50, 0.45);
    border-width: 1px;
    border-radius: 4px;
    padding: 5px 8px;
    margin-bottom: 5px;
}

.wboard-link-row--solution {
    background-color: rgba(206, 232, 204, 0.88);
    border-color: rgb(68, 132, 78);
}

.wboard-link-row--invented {
    background-color: rgba(244, 212, 206, 0.85);
    border-color: rgb(166, 74, 68);
}

.wboard-link-text {
    font-size: 12px;
    color: rgb(32, 22, 14);
    white-space: normal;
}

.wboard-conclusion-list {
    flex-grow: 1;
    margin-bottom: 10px;
}

.wboard-conclusion {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(236, 222, 194);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(110, 82, 48, 0.45);
    border-radius: 4px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.wboard-conclusion--selected {
    -unity-background-image-tint-color: rgb(228, 202, 248);
    border-color: rgb(118, 62, 152);
    border-width: 2px;
}

.wboard-conclusion-text {
    font-size: 13px;
    color: rgb(28, 20, 14);
    white-space: normal;
    -unity-text-align: middle-left;
}

.wboard-lamp-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 6px 8px;
    background-color: rgba(224, 208, 178, 0.78);
    border-radius: 4px;
}

.wboard-lamp {
    font-size: 13px;
    -unity-font-style: bold;
    padding: 2px 8px;
    border-radius: 3px;
}

.wboard-lamp--cold {
    color: rgb(42, 76, 128);
    background-color: rgba(188, 212, 242, 0.75);
}

.wboard-lamp--warm {
    color: rgb(146, 84, 16);
    background-color: rgba(248, 218, 162, 0.85);
}

.wboard-lamp--hot {
    color: rgb(146, 32, 26);
    background-color: rgba(246, 184, 178, 0.85);
}

.wboard-support-label {
    font-size: 12px;
    color: rgb(44, 32, 22);
}

.wboard-submit-button {
    height: 40px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(228, 198, 134);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 20, 12);
    font-size: 14px;
    -unity-font-style: bold;
}

.wboard-submit-button:hover {
    -unity-background-image-tint-color: rgb(248, 220, 158);
}

.wboard-feedback-banner {
    border-width: 1px;
    border-radius: 5px;
    padding: 8px 14px;
    margin-top: 10px;
}

.wboard-feedback-text {
    font-size: 14px;
    color: rgb(252, 246, 236);
    white-space: normal;
}

.banner--error {
    background-color: rgba(112, 32, 36, 0.92);
    border-color: rgb(212, 118, 118);
}

.banner--info {
    background-color: rgba(34, 68, 48, 0.92);
    border-color: rgb(118, 178, 134);
}

.wboard-banner-hint {
    color: rgb(232, 206, 250);
    font-size: 12px;
    margin-top: 2px;
}

.wboard-hint-popup {
    position: absolute;
    top: 8%;
    right: 6%;
    width: 420px;
    flex-direction: row;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 36px 42px 30px 42px;
}

.wboard-hint-portrait {
    width: 68px;
    height: 82px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: rgba(232, 218, 190, 0.85);
    border-color: rgba(74, 54, 34, 0.8);
    border-width: 1.5px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.wboard-hint-body {
    flex-grow: 1;
    flex-direction: column;
}

.wboard-hint-speaker {
    font-size: 15px;
    color: rgb(88, 38, 114);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.wboard-hint-text {
    font-size: 13px;
    color: rgb(32, 24, 18);
    margin-bottom: 8px;
}

.wboard-hint-close {
    height: 28px;
    padding: 0 16px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 216, 186);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 22, 14);
    font-size: 12px;
}
