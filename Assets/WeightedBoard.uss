.wboard-root {
    -unity-font-definition: url("project://database/Assets/Fonts/EBGaramond.ttf");
    background-color: rgba(10, 9, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.wboard-panel {
    width: 94%;
    height: 92%;
    max-width: 1480px;
    max-height: 880px;
    background-image: url("project://database/Assets/Art/UI/Cork_Board_Panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 38px 48px 34px 48px;
    flex-direction: column;
}

.wboard-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.wboard-back-button {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 218, 188);
    background-color: transparent;
    border-width: 0;
    padding: 5px 14px;
    color: rgb(32, 22, 14);
    font-size: 13px;
    -unity-font-style: bold;
}

.wboard-back-button:hover {
    -unity-background-image-tint-color: rgb(252, 236, 198);
}

.wboard-title {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
    font-size: 18px;
    color: rgb(28, 18, 12);
    -unity-font-style: bold;
    background-color: rgba(242, 228, 198, 0.88);
    border-color: rgba(104, 78, 48, 0.65);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 14px;
}

.wboard-status-badges {
    flex-direction: row;
    align-items: center;
}

.wboard-stat-pill {
    font-size: 12px;
    color: rgb(34, 24, 16);
    background-color: rgba(238, 224, 194, 0.88);
    border-color: rgba(104, 78, 48, 0.65);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 9px;
    margin-left: 6px;
}

.wboard-main-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.wboard-canvas-column {
    flex-grow: 1;
    min-height: 0;
    margin-right: 12px;
    background-color: rgba(68, 46, 26, 0.16);
    border-color: rgba(94, 66, 40, 0.35);
    border-width: 1px;
    border-radius: 6px;
    overflow: hidden;
    flex-direction: column;
}

.wboard-canvas {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    position: relative;
}

.wboard-clue-drawer {
    height: 68px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(242, 228, 198, 0.96);
    border-top-width: 1.5px;
    border-top-color: rgba(102, 74, 46, 0.72);
    padding: 4px 10px;
    flex-direction: column;
}

.wboard-clue-drawer-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
    flex-shrink: 0;
}

.wboard-clue-drawer-title {
    font-size: 14px;
    color: rgb(24, 14, 6);
    -unity-font-style: bold;
}

.wboard-clue-drawer-meta {
    font-size: 12px;
    color: rgb(92, 52, 14);
    -unity-font-style: bold;
}

.wboard-clue-drawer-scroll {
    flex-grow: 1;
    min-height: 0;
}

.wboard-clue-drawer-desc {
    font-size: 13.5px;
    color: rgb(26, 18, 10);
    white-space: normal;
}

.wboard-controls-legend {
    flex-shrink: 0;
    margin-top: 4px;
    border-radius: 4px;
    font-size: 12px;
    color: rgb(246, 238, 214);
    background-color: rgba(18, 13, 8, 0.90);
    padding: 4px 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.wboard-node {
    position: absolute;
    min-width: 116px;
    max-width: 152px;
    padding: 7px 10px;
    background-color: rgba(246, 236, 212, 0.95);
    border-color: rgba(96, 68, 40, 0.72);
    border-width: 1.5px;
    border-radius: 4px;
}

.wboard-node:hover {
    background-color: rgba(255, 246, 224, 0.99);
    border-color: rgb(146, 98, 28);
}

.wboard-node--selected {
    background-color: rgba(232, 210, 252, 0.96);
    border-color: rgb(118, 62, 152);
    border-width: 2px;
}

.wboard-node--hint {
    background-color: rgba(255, 240, 178, 0.98);
    border-color: rgb(198, 138, 28);
    border-width: 2px;
}

.wboard-node-name {
    font-size: 13px;
    color: rgb(24, 16, 8);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.wboard-side-ledger {
    width: 336px;
    flex-shrink: 0;
    background-color: rgba(242, 228, 198, 0.90);
    border-color: rgba(102, 74, 46, 0.72);
    border-width: 1.5px;
    border-radius: 6px;
    padding: 8px 10px;
    flex-direction: column;
}

.wboard-ledger-header {
    font-size: 12px;
    color: rgb(42, 28, 18);
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: rgba(102, 74, 46, 0.35);
    padding-bottom: 3px;
    margin-bottom: 5px;
    flex-shrink: 0;
}

.wboard-link-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 92px;
    max-height: 190px;
    margin-bottom: 8px;
}

.wboard-link-row {
    background-color: rgba(232, 216, 184, 0.85);
    border-color: rgba(112, 82, 50, 0.45);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 7px;
    margin-bottom: 4px;
}

.wboard-link-row--solution {
    background-color: rgba(206, 232, 204, 0.88);
    border-color: rgb(68, 132, 78);
}

.wboard-link-row--invented {
    background-color: rgba(244, 212, 206, 0.85);
    border-color: rgb(166, 74, 68);
}

.wboard-link-text {
    font-size: 12.5px;
    color: rgb(24, 16, 8);
    white-space: normal;
}

.wboard-conclusion-list {
    flex-grow: 1.4;
    min-height: 110px;
    margin-bottom: 8px;
}

.wboard-conclusion {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(236, 222, 194);
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(110, 82, 48, 0.45);
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 5px;
    white-space: normal;
    flex-shrink: 0;
}

.wboard-conclusion--selected {
    -unity-background-image-tint-color: rgb(228, 202, 248);
    border-color: rgb(118, 62, 152);
    border-width: 2px;
}

.wboard-conclusion--wrong {
    border-left-width: 4px;
    border-left-color: rgb(138, 118, 102);
}

.wboard-conclusion--partial {
    border-left-width: 4px;
    border-left-color: rgb(186, 128, 32);
}

.wboard-conclusion--complete {
    border-left-width: 4px;
    border-left-color: rgb(38, 126, 78);
}

.wboard-conclusion-badge {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(68, 46, 26);
    margin-bottom: 2px;
    letter-spacing: 0.5px;
}

.wboard-link-row--solution {
    border-left-width: 3px;
    border-left-color: rgb(46, 134, 84);
}

.wboard-conclusion-text {
    font-size: 13px;
    color: rgb(22, 14, 8);
    white-space: normal;
    -unity-text-align: middle-left;
}

.wboard-lamp-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 6px;
    padding: 4px 8px;
    background-color: rgba(224, 208, 178, 0.78);
    border-radius: 4px;
}

.wboard-lamp {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 3px 9px;
    margin-left: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(104, 78, 48, 0.45);
}

.wboard-lamp--cold {
    color: rgb(42, 76, 128);
    background-color: rgba(188, 212, 242, 0.90);
}

.wboard-lamp--warm {
    color: rgb(146, 84, 16);
    background-color: rgba(248, 218, 162, 0.92);
}

.wboard-lamp--hot {
    color: rgb(146, 32, 26);
    background-color: rgba(246, 184, 178, 0.92);
}

.wboard-submit-button {
    height: 36px;
    flex-shrink: 0;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(228, 198, 134);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 20, 12);
    font-size: 13px;
    -unity-font-style: bold;
}

.wboard-submit-button:hover {
    -unity-background-image-tint-color: rgb(248, 220, 158);
}

.wboard-feedback-banner {
    flex-shrink: 0;
    min-height: 28px;
    border-width: 1px;
    border-radius: 5px;
    padding: 5px 12px;
    margin-top: 6px;
}

.wboard-feedback-text {
    font-size: 12px;
    color: rgb(252, 246, 236);
    white-space: normal;
}

.banner--error {
    background-color: rgba(112, 32, 36, 0.92);
    border-color: rgb(212, 118, 118);
}

.banner--info {
    background-color: rgba(34, 68, 48, 0.92);
    border-color: rgb(118, 178, 134);
}

.wboard-banner-hint {
    color: rgb(232, 206, 250);
    font-size: 11px;
    margin-top: 2px;
}

.wboard-hint-popup {
    position: absolute;
    top: 8%;
    right: 6%;
    width: 420px;
    flex-direction: row;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 36px 42px 30px 42px;
}

.wboard-hint-portrait {
    width: 68px;
    height: 82px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: rgba(232, 218, 190, 0.85);
    border-color: rgba(74, 54, 34, 0.8);
    border-width: 1.5px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.wboard-hint-body {
    flex-grow: 1;
    flex-direction: column;
}

.wboard-hint-speaker {
    font-size: 15px;
    color: rgb(88, 38, 114);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.wboard-hint-text {
    font-size: 13px;
    color: rgb(32, 24, 18);
    margin-bottom: 8px;
}

.wboard-hint-close {
    height: 28px;
    padding: 0 16px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 216, 186);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 22, 14);
    font-size: 12px;
}
