<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/WeightedBoard.uss"/>
    <ui:VisualElement name="WeightedBoard-Root" class="wboard-root" style="position: absolute; width: 100%; height: 100%; display: none;">
        <ui:VisualElement name="BoardPanel" class="wboard-panel">
            <ui:VisualElement name="HeaderRow" class="wboard-header-row">
                <ui:Button name="CloseBoardButton" text="← Back  [H]" class="wboard-back-button"/>
                <ui:Label name="CaseTitleLabel" text="Deduction Board" class="wboard-title"/>
                <ui:VisualElement name="StatusBadges" class="wboard-status-badges">
                    <ui:Label name="ErrorCountLabel" text="Errors: 0" class="wboard-stat-pill"/>
                    <ui:Label name="FocusLabel" text="Focus 100/100" class="wboard-stat-pill"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="BoardMainRow" class="wboard-main-row">
                <ui:VisualElement name="CanvasColumn" class="wboard-canvas-column">
                    <ui:VisualElement name="NodeCanvas" class="wboard-canvas"/>
                </ui:VisualElement>

                <ui:VisualElement name="SideLedger" class="wboard-side-ledger">
                    <ui:Label text="Drawn Links (Right-click to sever)" class="wboard-ledger-header"/>
                    <ui:ScrollView name="LinkList" class="wboard-link-list"/>

                    <ui:Label text="Conclusions" class="wboard-ledger-header"/>
                    <ui:ScrollView name="ConclusionList" class="wboard-conclusion-list"/>

                    <ui:VisualElement name="LampRow" class="wboard-lamp-row">
                        <ui:Label name="LampLabel" text="Lamp: Cold" class="wboard-lamp wboard-lamp--cold"/>
                        <ui:Label name="SupportLabel" text="Support: 0%" class="wboard-support-label"/>
                    </ui:VisualElement>

                    <ui:Button name="SubmitButton" text="Submit Conclusion" class="wboard-submit-button"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="FeedbackBanner" class="wboard-feedback-banner" style="display: none;">
                <ui:Label name="FeedbackLabel" text="" class="wboard-feedback-text"/>
                <ui:Label name="HintLabel" text="" class="wboard-banner-hint" style="display: none;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="HintPopup" class="wboard-hint-popup" style="display: none;">
            <ui:VisualElement name="HintPortrait" class="wboard-hint-portrait"/>
            <ui:VisualElement name="HintBody" class="wboard-hint-body">
                <ui:Label name="HintSpeaker" text="Eliza" class="wboard-hint-speaker"/>
                <ui:Label name="HintText" text="" class="wboard-hint-text" style="white-space: normal;"/>
                <ui:Button name="HintClose" text="Dismiss" class="wboard-hint-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
