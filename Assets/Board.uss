.board-root {
    -unity-font-definition: url("project://database/Assets/Fonts/EBGaramond.ttf");
    background-color: rgba(10, 9, 8, 0.72);
    align-items: center;
    justify-content: center;
}

.board-panel {
    width: 88%;
    height: 86%;
    max-width: 1220px;
    max-height: 760px;
    background-image: url("project://database/Assets/Art/UI/Cork_Board_Panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 56px 68px 56px 68px;
    flex-direction: column;
}

.board-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.board-back-button {
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 218, 188);
    background-color: transparent;
    border-width: 0;
    padding: 7px 18px;
    color: rgb(32, 22, 14);
    font-size: 14px;
    -unity-font-style: bold;
}

.board-back-button:hover {
    -unity-background-image-tint-color: rgb(252, 236, 198);
}

.board-title {
    font-size: 22px;
    color: rgb(28, 18, 12);
    -unity-font-style: bold;
    background-color: rgba(242, 228, 198, 0.85);
    border-color: rgba(104, 78, 48, 0.65);
    border-width: 1px;
    border-radius: 4px;
    padding: 5px 14px;
}

.board-section-label {
    font-size: 13px;
    color: rgb(42, 28, 16);
    -unity-font-style: bold;
    background-color: rgba(236, 220, 188, 0.72);
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 3px;
    margin-bottom: 6px;
}

.clue-rack {
    min-height: 128px;
    max-height: 146px;
    flex-direction: row;
    margin-bottom: 10px;
    background-color: rgba(66, 46, 28, 0.22);
    border-color: rgba(88, 62, 38, 0.4);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
}

.clue-card {
    width: 168px;
    min-height: 94px;
    flex-shrink: 0;
    background-color: rgba(246, 236, 212, 0.94);
    border-color: rgba(110, 78, 44, 0.8);
    border-width: 1.5px;
    border-radius: 4px;
    padding: 8px 10px;
    margin-right: 10px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.clue-card:hover {
    background-color: rgba(255, 246, 224, 0.98);
    border-color: rgb(146, 98, 28);
}

.clue-card--selected {
    background-color: rgba(236, 218, 250, 0.96);
    border-color: rgb(118, 66, 152);
    border-width: 2px;
    border-radius: 4px;
}

.clue-card-name {
    font-size: 12px;
    color: rgb(30, 20, 12);
    -unity-font-style: bold;
    white-space: normal;
}

.clue-card-type {
    font-size: 10px;
    color: rgb(116, 76, 30);
    margin-top: auto;
}

.workspace-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.slot-button {
    width: 210px;
    height: 44px;
    margin-right: 10px;
    background-color: rgba(242, 228, 198, 0.88);
    border-color: rgba(112, 82, 48, 0.75);
    border-width: 1.5px;
    border-radius: 5px;
    color: rgb(68, 52, 36);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.slot-button:hover {
    background-color: rgba(252, 240, 214, 0.96);
}

.slot-button--filled {
    color: rgb(32, 20, 14);
    -unity-font-style: bold;
    border-color: rgb(124, 70, 156);
    border-width: 2px;
}

.link-button {
    height: 44px;
    padding: 0 20px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(216, 188, 238);
    background-color: transparent;
    border-width: 0;
    color: rgb(30, 18, 42);
    font-size: 14px;
    -unity-font-style: bold;
}

.link-button:hover {
    -unity-background-image-tint-color: rgb(235, 212, 252);
}

.premise-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-height: 78px;
    background-color: rgba(66, 46, 28, 0.18);
    border-color: rgba(88, 62, 38, 0.38);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 12px;
}

.premise-card {
    min-width: 185px;
    flex-shrink: 0;
    background-color: rgba(246, 236, 212, 0.94);
    border-color: rgb(118, 72, 150);
    border-width: 1.5px;
    border-radius: 5px;
    padding: 8px 12px;
    margin-right: 8px;
    margin-bottom: 6px;
}

.premise-card-title {
    font-size: 14px;
    color: rgb(32, 20, 16);
    white-space: normal;
}

.board-footer-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: auto;
    flex-shrink: 0;
}

.submit-button {
    height: 44px;
    padding: 0 22px;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(228, 198, 134);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 20, 12);
    font-size: 15px;
    -unity-font-style: bold;
}

.submit-button:hover {
    -unity-background-image-tint-color: rgb(248, 220, 158);
}

.submit-button--disabled {
    opacity: 0.72;
    -unity-font-style: normal;
}

.feedback-banner {
    border-width: 1px;
    border-radius: 5px;
    padding: 8px 14px;
    margin-top: 10px;
}

.feedback-text {
    font-size: 14px;
    color: rgb(252, 246, 236);
    white-space: normal;
}

.banner--error {
    background-color: rgba(112, 32, 36, 0.92);
    border-color: rgb(212, 118, 118);
}

.banner--info {
    background-color: rgba(34, 68, 48, 0.92);
    border-color: rgb(118, 178, 134);
}

.banner--hint {
    color: rgb(232, 206, 250);
    font-size: 13px;
    margin-top: 3px;
    white-space: normal;
}

.prompt-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 7, 6, 0.65);
    align-items: center;
    justify-content: center;
}

.prompt-card {
    width: 60%;
    max-width: 720px;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 46px 56px 40px 56px;
}

.prompt-question {
    font-size: 17px;
    color: rgb(28, 20, 14);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.option-button {
    white-space: normal;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(242, 232, 212);
    background-color: transparent;
    border-width: 0;
    padding: 10px 14px;
    margin-top: 8px;
    color: rgb(28, 20, 14);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.option-button:hover {
    -unity-background-image-tint-color: rgb(255, 240, 198);
}

.cancel-button {
    height: 36px;
    padding: 0 18px;
    margin-top: 12px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(210, 196, 174);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 22, 14);
    font-size: 13px;
}

.hint-popup {
    position: absolute;
    top: 8%;
    right: 6%;
    width: 420px;
    flex-direction: row;
    background-image: url("project://database/Assets/Art/UI/Ornate_Runic_Card.png");
    -unity-background-scale-mode: stretch-to-fill;
    padding: 36px 42px 30px 42px;
}

.hint-portrait {
    width: 68px;
    height: 82px;
    flex-shrink: 0;
    margin-right: 12px;
    background-color: rgba(232, 218, 190, 0.85);
    border-color: rgba(74, 54, 34, 0.8);
    border-width: 1.5px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.hint-body {
    flex-grow: 1;
    flex-direction: column;
}

.hint-speaker {
    font-size: 15px;
    color: rgb(88, 38, 114);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hint-text {
    font-size: 13px;
    color: rgb(32, 24, 18);
    margin-bottom: 8px;
}

.hint-close {
    height: 28px;
    padding: 0 16px;
    align-self: flex-end;
    background-image: url("project://database/Assets/Art/UI/Flat/UI_Flat_Button01a_1.png");
    -unity-background-image-tint-color: rgb(232, 216, 186);
    background-color: transparent;
    border-width: 0;
    color: rgb(32, 22, 14);
    font-size: 12px;
}
