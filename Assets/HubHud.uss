.hub-hud-root {
    -unity-font-definition: url("project://database/Assets/Fonts/Middleearth.ttf");
}

.hub-hud-panel {
    background-color: rgba(14, 11, 18, 0.8);
    border-color: rgba(255, 255, 255, 0.25);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
}

.hub-hud-case {
    font-size: 12px;
    color: rgb(200, 200, 200);
    text-shadow: 1px 1px 2px black;
}

.hub-hud-objective {
    font-size: 15px;
    color: rgb(229, 169, 60);
    text-shadow: 1px 1px 2px black;
    white-space: normal;
}

.hub-hud-text {
    font-size: 14px;
    color: white;
    text-shadow: 1px 1px 2px black;
}

.hub-hud-focus-bg {
    width: 180px;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 6px;
}

.hub-hud-focus-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(130, 80, 160);
    border-radius: 6px;
}

.hub-hud-footer {
    font-size: 13px;
    color: rgb(220, 220, 220);
    text-shadow: 1px 1px 2px black;
}
