<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/HUD.uss?fileID=7433441132597879392&amp;guid=05eccd6dbf30c0f40a158796a198cda4&amp;type=3#HUD"/>
    <ui:VisualElement name="HUD-Root" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="TopLeftPanel" class="hud-panel" style="position: absolute; top: 20px; left: 20px; flex-direction: row;">
            <ui:VisualElement style="align-items: center; margin-right: 0;">
                <ui:VisualElement name="UserIcon" class="icon-box" style="width: 50px; height: 50px; margin-bottom: 0; background-image: url(&quot;project://database/Assets/UI/IconProfile.png?fileID=2800000&amp;guid=1d25d8869928ce347afc0db58fb531a6&amp;type=3#IconProfile&quot;); background-color: rgba(255, 255, 255, 0); background-size: 75% 100%;"/>
                <ui:Label text="Golem" name="UserNameLabel" class="hud-text" style="font-size: 13px; margin-bottom: 0; margin-top: 0; padding-top: 0; padding-bottom: 0;"/>
                <ui:Label name="EscLabel" text="esc" class="keycap" style="margin-top: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; opacity: 0.2;"/>
            </ui:VisualElement>
            <ui:VisualElement style="justify-content: flex-start; margin-top: 0;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                    <ui:Label text="Focus Energy:" class="hud-text" style="margin-right: 5px;"/>
                    <ui:Label text="120/120" name="FocusValueLabel" class="hud-text" style="color: rgb(200, 200, 200);"/>
                </ui:VisualElement>
                <ui:VisualElement name="FocusBarBackground" style="width: 200px; height: 12px; background-color: rgba(255, 255, 255, 0.3); border-radius: 6px;">
                    <ui:VisualElement name="FocusBarFill" style="width: 100%; height: 100%; background-color: rgb(130, 80, 160); border-radius: 6px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomLeftPanel" class="hud-panel" style="position: absolute; bottom: 20px; left: 20px;">
            <ui:VisualElement name="GolemEyePanel" style="flex-direction: row; align-items: center; margin-bottom: 0; opacity: 0.2;">
                <ui:Label text="Tab" class="keycap" style="margin-right: 10px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                <ui:VisualElement name="GolemEyeIcon" class="icon-box" style="width: 30px; height: 30px; margin-right: 10px; background-image: url(&quot;project://database/Assets/UI/IconGolemEye.png?fileID=2800000&amp;guid=2efc35cefd2a6cb4b8a71c35caec06d3&amp;type=3#IconGolemEye&quot;); background-color: rgba(255, 255, 255, 0);"/>
                <ui:VisualElement style="flex-direction: column; color: rgb(27, 27, 27); opacity: 1;">
                    <ui:Label text="Golem Eye" class="hud-text-large" style="margin-bottom: 0; padding-bottom: 0;"/>
                    <ui:Label name="GolemCostText" text="Focus Energy Cost: 30" class="hud-text-small" style="color: rgb(200, 200, 200); padding-top: 0; margin-top: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="AetherSightRow" style="flex-direction: row; align-items: center; display: none;">
                <ui:Label text="1" class="keycap" style="margin-right: 10px;"/>
                <ui:VisualElement name="AetherSightIcon" class="icon-box" style="width: 30px; height: 30px; margin-right: 10px;"/>
                <ui:VisualElement style="flex-direction: column;">
                    <ui:Label text="Aether Sight" class="hud-text-large"/>
                    <ui:Label name="AetherCostText" text="Focus Energy Cost: 30" class="hud-text-small" style="color: rgb(200, 200, 200);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BottomRightPanel" class="hud-panel" style="position: absolute; bottom: 20px; right: 20px; align-items: flex-end;">
            <ui:VisualElement name="DeskPanel" style="flex-direction: row; align-items: center; margin-bottom: 5px; opacity: 0.2;">
                <ui:Label text="Desk" class="hud-text" style="margin-right: 10px;"/>
                <ui:Label text="G" class="keycap" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            </ui:VisualElement>
            <ui:VisualElement name="BoardPanel" style="flex-direction: row; align-items: center; opacity: 0.2;">
                <ui:Label text="Board" class="hud-text" style="margin-right: 10px;"/>
                <ui:Label text="H" class="keycap" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CenterPanel" style="position: absolute; top: 50%; left: 50%; translate: -50% -50%; align-items: center; justify-content: center;">
            <ui:VisualElement style="position: absolute; width: 6px; height: 6px; background-color: black; border-radius: 3px; align-items: center; justify-content: center;">
                <ui:VisualElement style="width: 4px; height: 4px; background-color: white; border-radius: 2px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="InteractionContainer" style="position: absolute; top: 20px; align-items: center; display: none;">
                <ui:Label name="InteractionText" text="[L-Click] Inspect" style="font-size: 15px; color: white; -unity-text-outline-width: 0; -unity-text-outline-color: black; margin-bottom: 5px;"/>
                <ui:Label name="ItemDescriptionText" text="Item Description" style="font-size: 13px; color: rgb(200, 200, 200); -unity-text-outline-width: 0; -unity-text-outline-color: black; max-width: 400px; white-space: normal; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
